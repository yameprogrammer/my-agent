# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd
*.db
*.db-journal
*.db-wal
*.db-shm

# Orphan experiment trees (pycache-only leftovers; do not reintroduce without sources)
/packages/
/src/
/apps/

# Deploy runtime logs (keep deploy/logs/.gitkeep)
deploy/logs/*
!deploy/logs/.gitkeep

# Virtual Environment
.venv/
venv/
ENV/

# Configuration & secrets (never commit real credentials)
.env
.env.*
!.env.template
!.env.example

# Local secrets / dumps / backups that may contain API keys
secrets/
exports/
backups/
*.pem
*.p12
*.pfx
*backup*.json
*_export*.json
novel_system_backup_*.json

# Testing / IDEs
.pytest_cache/
.vscode/
.idea/
*.swp
*.swo

# Local Binaries
ngrok.exe
ngrok
bin/

# OS
.DS_Store
Thumbs.db
