# =================================================================
# '소설 싸개' 프로젝트 프로덕션/로컬 환경 변수 템플릿
# 복사하여 .env 파일로 사용하시고 실제 값들을 설정하십시오.
# =================================================================

# 1. 애플리케이션 기본 설정
# - development: 개발/로컬 환경 (기본 비밀값 사용 시 경고 발생)
# - production: 프로덕션 환경 (기본 비밀값 사용 시 구동 거부 및 강력한 패스워드 정책 적용)
ENVIRONMENT=development

# 2. 데이터베이스 설정
# PostgreSQL pgvector 호환 연결 정보
# 예: postgresql+asyncpg://<username>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/novel_db

# 3. 인증 및 JWT 설정
# JWT_SECRET: 프로덕션 배포 시 반드시 고유하고 강력한 키로 변경하십시오.
JWT_SECRET=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 4. CORS 설정
# 허용할 Origin 목록을 쉼표(,) 및 JSON 배열 형태로 설정
# 예: ["http://localhost:3000", "https://yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

# 5. 데이터 보안 (API 키 암호화용) — production 필수
# API_KEY_ENCRYPTION_SECRET: 사용자별 override API Key DB 암호화용.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENVIRONMENT=production 에서는 미설정 시 기동 거부. 미설정 development 는 평문 폴백(비권장).
API_KEY_ENCRYPTION_SECRET=

# 6. AI LLM API Keys
# AI 작가 시스템 및 RAG 구동을 위해 필요합니다.
# 프로젝트/에이전트별로 UI에서 개별 키를 오버라이드할 수 있으며, 아래 값은 서버 기본 폴백입니다.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# NVIDIA NIM (build.nvidia.com 에서 nvapi-... 키 발급)
# Base URL 은 코드에 https://integrate.api.nvidia.com/v1 로 고정됩니다.
NVIDIA_API_KEY=

# 6b. 워크플로 / LLM 안전 가드 (무한 루프·장시간 hang 방지)
# LangGraph 스텝 상한 — 보수적 기본 30. 씬이 많으면 40~60 으로 상향.
WORKFLOW_RECURSION_LIMIT=30
# 단일 LLM HTTP 요청 타임아웃(초). 0 이하면 비활성.
LLM_REQUEST_TIMEOUT_SECONDS=120
# Plotter 최대 씬 수 (초과분은 자동 절단)
MAX_SCENES_PER_EPISODE=8
# HITL 반려(교정) 최대 횟수 — 초과 시 강제 저장 경로
MAX_HITL_FEEDBACK_ROUNDS=5

# 7. 외부 리서치 및 에이전트 서비스 API Keys
TAVILY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 8. 이메일(SMTP) 설정
# 회원가입 승인 알림 메일 발송용
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="AI 소설 작가 시스템"

# 9. 텔레그램 승인 봇 설정
# 가입 승인 요청 및 간편 알림 발송용
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# 10. 관리자 설정
ADMIN_EMAIL=admin@example.com
BASE_URL=http://localhost:8000

# 11. 최초 배포 시 생성되는 수퍼유저 크리덴셜
# production: 기본/약한 비밀번호면 기동 거부. docker-compose.prod 는 필수 env.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin-pass-123!
INITIAL_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------
# 보안 메모 (공개 GitHub 레포)
# - .env 는 절대 커밋하지 마십시오 (.gitignore)
# - 푸시 전: python scripts/check_no_secrets.py
# - export/backup 기본값: API 키 미포함. 필요 시 include_secrets=true
# - production: JWT_SECRET, API_KEY_ENCRYPTION_SECRET, DB 비밀번호, admin 비밀번호 필수
# -----------------------------------------------------------------
